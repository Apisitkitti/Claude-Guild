  "queue_loop": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Looping: {what} failed {count} time",
        "countPlural=*": "Looping: {what} failed {count} times"
      }
    }
