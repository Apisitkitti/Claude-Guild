        "callsPlural=one": "{calls} tool call",
        "callsPlural=*": "{calls} tool calls"
      }
    }
  ],
  "receipt_calls_none": [
    {
      "declarations": ["input calls", "local callsPlural = calls: plural"],
      "selectors": ["callsPlural"],
