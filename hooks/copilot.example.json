{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "payload=$(cat); (printf '%s' \"$payload\" | curl -s --max-time 1 -X POST -H 'Content-Type: application/json' --data-binary @- 'http://localhost:5050/events?source=copilot&event=sessionStart' >/dev/null 2>&1 &); true",
        "timeoutSec": 3
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "payload=$(cat); (printf '%s' \"$payload\" | curl -s --max-time 1 -X POST -H 'Content-Type: application/json' --data-binary @- 'http://localhost:5050/events?source=copilot&event=sessionEnd' >/dev/null 2>&1 &); true",
        "timeoutSec": 3
      }
    ],
