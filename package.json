{
  "name": "claude-office",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5050 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 5050 -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "dev:lan": "GUILD_REQUIRE_TOKEN=1 next dev -p 5050 -H 0.0.0.0",
    "start:lan": "GUILD_REQUIRE_TOKEN=1 next start -p 5050 -H 0.0.0.0",
    "share": "next build && next start -p 5050 -H 127.0.0.1",
    "guild:token": "node scripts/guild-token.mjs",
    "guild:rotate": "node scripts/guild-token.mjs --rotate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
